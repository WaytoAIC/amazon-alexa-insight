{
  "manifest_version": 3,
  "name": "Alexa 产品洞察",
  "version": "2.1.0",
  "description": "批量向亚马逊 Alexa for Shopping（原 Rufus）提问，采集竞品差评痛点与产品洞察 · WaytoAIC",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.co.jp/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.in/*",
    "https://www.amazon.com.mx/*",
    "https://www.amazon.sg/*",
    "https://www.amazon.com.br/*",
    "https://www.amazon.nl/*",
    "https://www.amazon.sa/*",
    "https://www.amazon.ae/*",
    "https://www.amazon.pl/*",
    "https://www.amazon.se/*",
    "https://www.amazon.com.be/*",
    "https://www.amazon.eg/*"
  ],
  "action": {
    "default_title": "Alexa 产品洞察",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.sa/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.eg/*"
      ],
      "js": ["content/network-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.sa/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.eg/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
